# Pokemon GO Raid Roster Toolkit
#
# The static browser app does not require passwords, API keys, or account
# credentials. These values are safe public defaults for local scripts,
# deployment wrappers, or future tooling that wants environment-based config.

POKEMON_RAID_ROSTER_APP_BASE_URL=http://localhost:8000/outputs/pokemon-raid-roster/
POKEMON_RAID_ROSTER_PUBLIC_DATA_BASE_URL=https://raw.githubusercontent.com/mgrann03/pokemon-resources/main/
POKEMON_RAID_ROSTER_PUBLIC_DATA_FALLBACK_URL=https://pokemon-resources.mgrann03.workers.dev/
POKEMON_RAID_ROSTER_SPRITE_BASE_URL=https://www.serebii.net/pokemongo/pokemon/
